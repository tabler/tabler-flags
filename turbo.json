{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "outputs": ["dist/**", "src/flags/**", "src/flags-list.ts"],
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../src/**", "../../flags.json", "../../.build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "typecheck": {
      "dependsOn": ["build", "^build"]
    }
  }
}
