{
  "name": "tabler-flags",
  "version": "0.0.1",
  "description": "Country flag components for React, Vue, Preact and Astro, plus raw SVG and PNG assets.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabler/tabler-flags.git"
  },
  "private": true,
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "import-flags": "node ./.build/import-flags.mjs && pnpm run validate",
    "validate": "node ./.build/validate.mjs",
    "update-readme": "node ./.build/update-readme.mjs",
    "clean": "turbo run clean",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "build": "pnpm run update-readme && pnpm run build:packages && pnpm run typecheck",
    "build:packages": "pnpm run build:flags && pnpm run build:png && pnpm run build:react && pnpm run build:vue && pnpm run build:preact && pnpm run build:astro",
    "build:flags": "pnpm --filter @tabler/flags build",
    "build:png": "pnpm --filter @tabler/flags-png build",
    "build:react": "pnpm --filter @tabler/flags-react build",
    "build:vue": "pnpm --filter @tabler/flags-vue build",
    "build:preact": "pnpm --filter @tabler/flags-preact build",
    "build:astro": "pnpm --filter @tabler/flags-astro build",
    "build:preview": "pnpm --filter preview build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "author": "Paweł Kuna (https://codecalm.net)",
  "license": "MIT",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "fs-extra": "^11.4.1",
    "glob": "^13.0.6",
    "rollup": "^4.64.2",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-license": "^3.7.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "svgo": "^4.1.0",
    "svgson": "^5.3.1",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.4.2"
}
