{
  "name": "@tabler/flags-png",
  "version": "0.0.3",
  "license": "MIT",
  "description": "Country flags as PNG files in four variants and seven sizes.",
  "homepage": "https://github.com/tabler/tabler-flags",
  "bugs": {
    "url": "https://github.com/tabler/tabler-flags/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabler/tabler-flags.git",
    "directory": "packages/flags-png"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./*": "./dist/*",
    "./package.json": "./package.json"
  },
  "keywords": [
    "flags",
    "country",
    "png",
    "icons"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run copy:license && node build.mjs",
    "copy:license": "cp ../../LICENSE ./LICENSE",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
