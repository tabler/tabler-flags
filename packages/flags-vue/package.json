{
  "name": "@tabler/flags-vue",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Country flags as Vue 3 components.",
  "homepage": "https://github.com/tabler/tabler-flags",
  "bugs": {
    "url": "https://github.com/tabler/tabler-flags/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabler/tabler-flags.git",
    "directory": "packages/flags-vue"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/cjs/tabler-flags-vue.cjs",
  "module": "./dist/esm/tabler-flags-vue.mjs",
  "types": "./dist/tabler-flags-vue.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tabler-flags-vue.d.ts",
      "import": "./dist/esm/tabler-flags-vue.mjs",
      "require": "./dist/cjs/tabler-flags-vue.cjs"
    },
    "./package.json": "./package.json"
  },
  "amdName": "TablerFlagsVue",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "flags",
    "country",
    "svg",
    "vue",
    "icons"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run copy:license && pnpm run build:flags && pnpm run typecheck && pnpm run build:bundles",
    "build:flags": "node build.mjs",
    "build:bundles": "rollup -c ./rollup.config.mjs",
    "copy:license": "cp ../../LICENSE ./LICENSE",
    "clean": "rm -rf dist && find . ! -name '.gitkeep' -path '*/src/flags/*' -exec rm -rf {} +",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {},
  "peerDependencies": {
    "vue": ">=3.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  }
}
