{
  "name": "@tabler/flags-react",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Country flags as React components.",
  "homepage": "https://github.com/tabler/tabler-flags",
  "bugs": {
    "url": "https://github.com/tabler/tabler-flags/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabler/tabler-flags.git",
    "directory": "packages/flags-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/cjs/tabler-flags-react.cjs",
  "module": "./dist/esm/tabler-flags-react.mjs",
  "types": "./dist/tabler-flags-react.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tabler-flags-react.d.ts",
      "import": "./dist/esm/tabler-flags-react.mjs",
      "require": "./dist/cjs/tabler-flags-react.cjs"
    },
    "./package.json": "./package.json"
  },
  "amdName": "TablerFlagsReact",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "flags",
    "country",
    "svg",
    "react",
    "icons"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run copy:license && pnpm run build:flags && pnpm run typecheck && pnpm run build:bundles",
    "build:flags": "node build.mjs",
    "build:bundles": "rollup -c ./rollup.config.mjs",
    "copy:license": "cp ../../LICENSE ./LICENSE",
    "clean": "rm -rf dist && find . ! -name '.gitkeep' -path '*/src/flags/*' -exec rm -rf {} +",
    "test": "vitest run --typecheck",
    "typecheck": "tsc"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": ">= 16"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jest-serializer-html": "^7.1.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.3"
  }
}
